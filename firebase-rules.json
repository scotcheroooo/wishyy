{
  "rules": {
    "families": {
      "$familyCode": {
        ".read": "auth != null || true",
        ".write": "auth != null || true"
      }
    },
    "familyMembers": {
      "$familyCode": {
        ".read": true,
        ".write": true
      }
    },
    "lists": {
      ".read": true,
      "$listId": {
        ".write": true
      }
    },
    "gifts": {
      "$listId": {
        ".read": true,
        ".write": true
      }
    },
    "users": {
      "$userId": {
        ".read": true,
        ".write": true
      }
    },
    "userFamilies": {
      "$userId": {
        ".read": true,
        ".write": true
      }
    }
  }
}